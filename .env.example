# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实密码。
# 系统环境变量优先于 .env。

# 财富管理访问密码；留空时仅允许本机（127.0.0.1 / ::1）访问
WM_PASSWORD=

# Flask session 密钥，建议使用一段足够长的随机字符串；
# 留空时每次重启都会生成随机密钥，登录状态会失效
WM_SECRET_KEY=

# 可选：财富管理单独使用一个 SQLite 文件；不设置则使用 DATA_DIR/qdii.db
# WM_DB_PATH=

# 本地 / PM2 部署可选；Docker Compose 固定使用 /app/data，不需要在这里设置
# DATA_DIR=./data

# 日额度变动 webhook 推送地址和密钥
WEBHOOK_URL=
WEBHOOK_SECRET=
